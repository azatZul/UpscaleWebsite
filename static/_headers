# Fingerprinted CSS and JS can be cached permanently.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Unfingerprinted media uses a shorter cache.
/resources/*
  Cache-Control: public, max-age=604800

# Optional multi-core WebAssembly requires an isolated page. All lab
# dependencies are served from this site, so these headers stay self-contained.
/lab/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cache-Control: no-store

/models/*
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: same-origin

/benchmarks/*
  Cache-Control: public, max-age=604800
  Cross-Origin-Resource-Policy: same-origin

# Keep Apple association files fresh and correctly typed.
/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: public, max-age=0, must-revalidate

/apple-app-site-association
  Content-Type: application/json
  Cache-Control: public, max-age=0, must-revalidate
