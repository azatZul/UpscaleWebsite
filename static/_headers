# Netlify serves everything with `max-age=0, must-revalidate` by default, which is right
# for HTML but makes the browser re-check every image and video on every visit.

# assets/ is fingerprinted by build.py (site.css?v=<md5>), so a change always arrives
# under a new URL and the old one can be cached forever
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# resources/ is not fingerprinted — a week is short enough that replacing an image in
# place still reaches everyone quickly, long enough to stop re-downloading 50 MB of media
/resources/*
  Cache-Control: public, max-age=604800

# Apple fetches these as JSON and must always see the current version
/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: public, max-age=0, must-revalidate

/apple-app-site-association
  Content-Type: application/json
  Cache-Control: public, max-age=0, must-revalidate
