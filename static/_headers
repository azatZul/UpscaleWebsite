# Unfingerprinted media uses a shorter cache.
/resources/*
  Cache-Control: public, max-age=604800

# Optional multi-core WebAssembly requires an isolated page. All lab
# dependencies are served from this site, so these headers stay self-contained.
/lab/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cache-Control: no-store

/models/*
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: same-origin

# The browser tool and its versioned engine use a worker on this origin. The
# page exists at /free-upscale/ and under every locale prefix.
/free-upscale/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cache-Control: no-cache
  X-Robots-Tag: noindex, nofollow

/:lang/free-upscale/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  Cache-Control: no-cache
  X-Robots-Tag: noindex, nofollow

/assets/processor/*
  Cache-Control: public, max-age=31536000, immutable
  Cross-Origin-Resource-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

# These stylesheets use stable names, so revalidate after a deployment.
/assets/site.css
  Cache-Control: no-cache

/assets/upscale.css
  Cache-Control: no-cache

/benchmarks/*
  Cache-Control: public, max-age=604800
  Cross-Origin-Resource-Policy: same-origin

# Keep Apple association files fresh and correctly typed.
/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: public, max-age=0, must-revalidate

/apple-app-site-association
  Content-Type: application/json
  Cache-Control: public, max-age=0, must-revalidate
