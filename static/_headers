# Fingerprinted CSS and JS can be cached permanently.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Unfingerprinted media uses a shorter cache.
/resources/*
  Cache-Control: public, max-age=604800

# Keep Apple association files fresh and correctly typed.
/.well-known/apple-app-site-association
  Content-Type: application/json
  Cache-Control: public, max-age=0, must-revalidate

/apple-app-site-association
  Content-Type: application/json
  Cache-Control: public, max-age=0, must-revalidate

# Shared processing results are private-by-link and must not be indexed or embedded.
/results/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Content-Security-Policy: default-src 'self'; connect-src 'self' https://auralens-406817559814.us-central1.run.app; img-src 'self' data: https://storage.googleapis.com; style-src 'self'; script-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
